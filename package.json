{
  "name": "opendots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @opendots/server dev\" \"pnpm --filter @opendots/web dev\"",
    "build": "pnpm --filter @opendots/web build",
    "start": "pnpm --filter @opendots/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "search:up": "pnpm --filter @opendots/server search:up",
    "search:down": "pnpm --filter @opendots/server search:down",
    "search:logs": "pnpm --filter @opendots/server search:logs",
    "test:search:live": "pnpm --filter @opendots/server test:search:live",
    "auth:admin": "pnpm --filter @opendots/server auth:admin",
    "test:ui": "pnpm --filter @opendots/server exec tsx scripts/ui-smoke.ts",
    "desktop:build": "pnpm --filter @opendots/server exec tsx scripts/desktop-build.ts",
    "test:computer:live": "pnpm --filter @opendots/server exec tsx scripts/desktop-smoke.ts",
    "test:images:ui": "pnpm --filter @opendots/server exec tsx scripts/images-smoke.ts",
    "test:onboarding:ui": "pnpm --filter @opendots/server exec tsx scripts/onboarding-smoke.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "1.58.2"
  },
  "packageManager": "pnpm@10.28.0"
}
