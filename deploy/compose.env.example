# Copy to .env at repository root. Docker Compose loads this file automatically.
# Linux host, Docker Engine and Compose >= 2.24 required.
OPENDOTS_DATA_DIR=/var/lib/opendots
OPENDOTS_PORT=3000
OPENDOTS_SEARCH_PORT=18080
OPENDOTS_PUBLIC_URL=https://opendots.snyders.xyz
OPENDOTS_DOMAIN=opendots.snyders.xyz
OPENDOTS_APP_MEMORY=2g
OPENDOTS_APP_CPUS=2
OPENDOTS_DESKTOP_MEMORY=2g
OPENDOTS_DESKTOP_CPUS=2
OPENDOTS_COMPUTER_MEMORY=2g
OPENDOTS_COMPUTER_CPUS=2
# Close after creating the desired accounts:
# OPENDOTS_REGISTRATION=closed
# OPENDOTS_GOOGLE_CLIENT_ID=
# OPENDOTS_GOOGLE_CLIENT_SECRET=
# OPENDOTS_MICROSOFT_CLIENT_ID=
# OPENDOTS_MICROSOFT_CLIENT_SECRET=
# OPENDOTS_GITHUB_CLIENT_ID=
# OPENDOTS_GITHUB_CLIENT_SECRET=
# Optional wallpaper opt-out; defaults to a local time-of-day cycle.
# OPENDOTS_DESKTOP_WALLPAPER=off
# Optional build-only combined CA bundle for a corporate HTTPS proxy:
# OPENDOTS_CA_FILE=/absolute/path/to/combined-ca.pem
