{
  "name": "@opendots/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:search:live": "tsx scripts/search-smoke.ts",
    "search:up": "tsx scripts/search-service.ts up",
    "search:down": "tsx scripts/search-service.ts down",
    "search:logs": "tsx scripts/search-service.ts logs",
    "auth:admin": "tsx scripts/auth-admin.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.81",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opendots/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.148",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "hoodiecrow-imap": "^3.3.1",
    "smtp-server": "^3.20.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
