# Tous les réglages sont facultatifs.
# OPENDOTS_PORT=4317
# OPENDOTS_HOST=127.0.0.1
# OPENDOTS_DATA_DIR=./data
# PostgreSQL externe (sinon PostgreSQL embarqué via PGlite, dans OPENDOTS_DATA_DIR/pg)
# DATABASE_URL=postgres://user:pass@localhost:5432/opendots
# Clé de chiffrement des secrets (32 octets en base64). Par défaut : data/secret.key
# OPENDOTS_SECRET_KEY=
# URL publique pour les webhooks entrants
# OPENDOTS_PUBLIC_URL=https://opendots.example.com
# Jeton exigé par l'API si l'application est exposée au réseau
# OPENDOTS_TOKEN=
# Autoriser les compagnons à lire des adresses du réseau local (Home Assistant…)
# OPENDOTS_ALLOW_PRIVATE_FETCH=1
