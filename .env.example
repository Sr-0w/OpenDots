# Injecter ces variables via le gestionnaire de processus ou les exporter.
# Le serveur ne charge pas .env automatiquement.
# OPENDOTS_PORT=4317
# OPENDOTS_HOST=127.0.0.1
# OPENDOTS_DATA_DIR=./data
# URL publique HTTPS pour OAuth, cookies Secure et webhooks
# OPENDOTS_PUBLIC_URL=https://opendots.snyders.xyz
# Fermer les inscriptions après création des comptes souhaités
# OPENDOTS_REGISTRATION=closed
# Chaque utilisateur fournit sa clé OpenRouter dans son espace personnel.
# OPENROUTER_API_KEY n'est utilisé que par les scripts de confiance hors compte.
# Clé de chiffrement optionnelle (32 octets en base64) ; sinon un fichier par compte.
# OPENDOTS_SECRET_KEY=
# Applications OAuth du déploiement, configurées UNE FOIS par l'opérateur.
# Aussi configurables dans l'interface d'un administrateur (pnpm auth:admin email).
# OPENDOTS_GOOGLE_CLIENT_ID=
# OPENDOTS_GOOGLE_CLIENT_SECRET=
# OPENDOTS_MICROSOFT_CLIENT_ID=
# OPENDOTS_MICROSOFT_CLIENT_SECRET=
# OPENDOTS_GITHUB_CLIENT_ID=
# OPENDOTS_GITHUB_CLIENT_SECRET=
# PostgreSQL externe pour scripts de confiance ; comptes isolés toujours sur PGlite.
# DATABASE_URL=postgres://user:pass@localhost:5432/opendots
# Ancien jeton pour scripts hors compte ; ne remplace pas les sessions du serveur.
# OPENDOTS_TOKEN=
# Autoriser les lectures web du réseau privé (uniquement déploiement de confiance)
# OPENDOTS_ALLOW_PRIVATE_FETCH=1

# Quota des images jointes par compte (Mo), défaut 512
# OPENDOTS_ATTACHMENTS_QUOTA_MB=512
# Mémoire maximale du conteneur graphique par compte, défaut 2g
# OPENDOTS_DESKTOP_MEMORY=2g
